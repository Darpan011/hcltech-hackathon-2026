# Copy to .env and change every "change_me". Never commit .env.

# ---- PostgreSQL ----
POSTGRES_DB=onboardiq
POSTGRES_USER=onboard
POSTGRES_PASSWORD=change_me

# ---- Backend ----
# Used when running the backend directly on your laptop; docker-compose overrides it.
DATABASE_URL=postgresql+psycopg://onboard:change_me@localhost:5432/onboardiq
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=480
EXTRACTION_PROVIDER=mock
CORE_BANKING_KEY=change_me
DATA_DIR=/data/pack
UPLOAD_DIR=/data/uploads
UPLOAD_DEMO_DIR=/data/upload_demo
OUTPUT_DIR=/output
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Application date for new applications. The data pack is dated 2026-03-04, so demos use it
# (otherwise February bills look >90 days old). Empty = today's date in IST.
BUSINESS_DATE=2026-03-04
# Password given to the seeded demo users (local demo only).
SEED_PASSWORD=Demo@123
# false = branch onboarding (customer visits branch, KYC Officer enters data and creates their login)
# true  = online self-service (customer self-registers and applies)
SELF_SERVICE_ONBOARDING=false

# ---- Kafka (notifications only) ----
KAFKA_ENABLED=true
# Laptop runs use localhost:29092; docker-compose overrides to kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_NOTIFICATIONS=kyc.notifications
